FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Expose Vite dev server port
EXPOSE 5173

# Start Vite dev server
# Vite proxy (configured in vite.config.js) will handle routing to backend
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
